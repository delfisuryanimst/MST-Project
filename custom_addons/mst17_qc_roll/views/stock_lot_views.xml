<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_lot_form_inherit_qc_roll" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.qc.roll</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Roll" name="qc_roll">
                    <group>
                        <group>
                            <field name="mst_lot_warna" readonly="1"/>
                            <field name="mst_item_a_id" readonly="1"/>
                            <field name="mst_origin_lot_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="mst_history_ids" readonly="1">
                        <tree>
                            <field name="date"/>
                            <field name="event"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="document_name" string="Document"/>
                            <field name="user_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
