<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_qc_roll" model="ir.ui.view">
        <field name="name">res.company.form.inherit.qc.roll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="QC Roll" name="qc_roll">
                    <group>
                        <field name="mst_roll_id_start"/>
                        <field name="mst_qc_location_id" options="{'no_create': True}"/>
                        <field name="mst_qc_qty_tolerance"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
