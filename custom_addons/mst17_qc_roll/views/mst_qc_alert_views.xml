<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mst_qc_alert_tree" model="ir.ui.view">
        <field name="name">mst.qc.alert.tree</field>
        <field name="model">mst.qc.alert</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="create_date" string="Date"/>
                <field name="picking_id"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="result_type" widget="badge"/>
                <field name="qty_before" sum="Total"/>
                <field name="qty_down" sum="Total"/>
                <field name="qty_scrap" sum="Total"/>
                <field name="qty_diff" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <record id="view_mst_qc_alert_form" model="ir.ui.view">
        <field name="name">mst.qc.alert.form</field>
        <field name="model">mst.qc.alert</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="lot_id"/>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="picking_id"/>
                            <field name="inspection_id"/>
                            <field name="result_type"/>
                        </group>
                        <group>
                            <field name="qty_before"/>
                            <field name="qty_result"/>
                            <field name="qty_down"/>
                            <field name="qty_scrap"/>
                            <field name="qty_diff"/>
                        </group>
                    </group>
                    <field name="reason"/>
                    <group string="Documents">
                        <field name="conversion_ids" widget="many2many_tags"/>
                        <field name="scrap_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mst_qc_alert_pivot" model="ir.ui.view">
        <field name="name">mst.qc.alert.pivot</field>
        <field name="model">mst.qc.alert</field>
        <field name="arch" type="xml">
            <pivot string="QC Roll Alerts">
                <field name="partner_id" type="row"/>
                <field name="create_date" interval="month" type="col"/>
                <field name="qty_down" type="measure"/>
                <field name="qty_scrap" type="measure"/>
                <field name="qty_diff" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_mst_qc_alert_search" model="ir.ui.view">
        <field name="name">mst.qc.alert.search</field>
        <field name="model">mst.qc.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_type" string="Result" context="{'group_by': 'result_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mst_qc_alert" model="ir.actions.act_window">
        <field name="name">QC Roll Alerts</field>
        <field name="res_model">mst.qc.alert</field>
        <field name="view_mode">tree,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No QC Roll Alert yet</p>
            <p>An alert is made automatically when a roll is validated with a downgrade, a scrap or a qty
                difference above the tolerance.</p>
        </field>
    </record>
</odoo>
