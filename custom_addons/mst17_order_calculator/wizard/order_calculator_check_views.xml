<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_calculator_check_form" model="ir.ui.view">
        <field name="name">order.calculator.check.form</field>
        <field name="model">order.calculator.check</field>
        <field name="arch" type="xml">
            <form string="Cek siap kirim">
                <field name="product_id" invisible="1"/>
                <field name="qty" invisible="1"/>
                <field name="need_date" invisible="1"/>
                <div class="text-muted mb-2"><field name="info"/></div>
                <field name="result_html" nolabel="1"/>
                <footer>
                    <button string="Tutup" special="cancel" class="btn-primary"/>
                    <button name="action_open_calculator" string="Buka di Order Kalkulator" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
