<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 22:00 UTC = 05:00 WIB -->
        <record id="cron_update_history" model="ir.cron">
            <field name="name">Order Kalkulator: hitung histori</field>
            <field name="model_id" ref="model_order_calculator_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_history()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="DateTime.now().replace(hour=22, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
