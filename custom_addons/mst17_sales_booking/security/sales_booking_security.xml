<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same reach as sales orders: own documents, all documents, managers. -->
    <record id="rule_booking_own" model="ir.rule">
        <field name="name">Sales Booking: own documents</field>
        <field name="model_id" ref="model_mst_sale_booking"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_booking_all" model="ir.rule">
        <field name="name">Sales Booking: all documents</field>
        <field name="model_id" ref="model_mst_sale_booking"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
    <record id="rule_booking_line_own" model="ir.rule">
        <field name="name">Sales Booking Line: own documents</field>
        <field name="model_id" ref="model_mst_sale_booking_line"/>
        <field name="domain_force">['|', ('booking_id.user_id', '=', user.id), ('booking_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_booking_line_all" model="ir.rule">
        <field name="name">Sales Booking Line: all documents</field>
        <field name="model_id" ref="model_mst_sale_booking_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
    <record id="rule_reservation_own" model="ir.rule">
        <field name="name">Stock Reservation: own documents</field>
        <field name="model_id" ref="model_mst_stock_reservation"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_reservation_all" model="ir.rule">
        <field name="name">Stock Reservation: all documents</field>
        <field name="model_id" ref="model_mst_stock_reservation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="rule_reservation_company" model="ir.rule">
        <field name="name">Stock Reservation: company</field>
        <field name="model_id" ref="model_mst_stock_reservation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_booking_company" model="ir.rule">
        <field name="name">Sales Booking: company</field>
        <field name="model_id" ref="model_mst_sale_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
