<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_booking" model="ir.ui.view">
        <field name="name">sale.order.form.booking</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <button name="action_quotation_send" position="before">
                <button name="action_book_stock" string="Book Stock" type="object" invisible="not can_book_stock"/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_view_bookings" type="object" class="oe_stat_button" icon="fa-lock"
                        invisible="booking_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="booking_count"/></span>
                        <span class="o_stat_text">Booking</span>
                    </div>
                </button>
            </div>
            <field name="payment_term_id" position="after">
                <field name="booking_id" readonly="state not in ('draft', 'sent')" options="{'no_create': True}"/>
                <field name="can_book_stock" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
