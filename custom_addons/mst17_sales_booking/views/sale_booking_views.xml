<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_booking_form" model="ir.ui.view">
        <field name="name">mst.sale.booking.form</field>
        <field name="model">mst.sale.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state != 'to_approve'" groups="sales_team.group_sale_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'to_approve'" groups="sales_team.group_sale_manager"/>
                    <button name="action_release" string="Release" type="object"
                            invisible="state != 'booked'"
                            confirm="Free the remaining booked stock and close this booking?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'to_approve')"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('to_approve', 'reject', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,booked,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-dollar"
                                invisible="not sale_count">
                            <field name="sale_count" widget="statinfo" string="Sales Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="team_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="booking_date"/>
                            <field name="booking_approval_date"/>
                            <field name="expiry_date" readonly="state not in ('draft', 'to_approve', 'booked')"/>
                            <field name="warehouse_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Booking Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="product_uom_qty" sum="Total"/>
                                    <field name="free_qty" optional="show"/>
                                    <field name="product_uom" groups="uom.group_uom" options="{'no_create': True}"/>
                                    <field name="used_qty" sum="Total"/>
                                    <field name="released_qty" sum="Total"/>
                                    <field name="remaining_qty" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Remarks" name="remarks">
                            <field name="note" placeholder="Negotiation notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="sale_booking_tree" model="ir.ui.view">
        <field name="name">mst.sale.booking.tree</field>
        <field name="model">mst.sale.booking</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('closed', 'reject', 'cancel')" decoration-info="state == 'to_approve'">
                <field name="name"/>
                <field name="booking_date"/>
                <field name="expiry_date"/>
                <field name="partner_id"/>
                <field name="state" widget="badge" decoration-success="state == 'booked'"
                       decoration-warning="state == 'to_approve'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="team_id" optional="show"/>
                <field name="note" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="sale_booking_search" model="ir.ui.view">
        <field name="name">mst.sale.booking.search</field>
        <field name="model">mst.sale.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="my" string="My Bookings" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="booked" string="Booked" domain="[('state', '=', 'booked')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <filter name="reject" string="Rejected" domain="[('state', '=', 'reject')]"/>
                <separator/>
                <filter name="expired" string="Booking Expired"
                        domain="[('state', '=', 'booked'), ('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="expiring" string="Booking Expiring in 7 Days"
                        domain="[('state', '=', 'booked'), ('expiry_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Booking Date" context="{'group_by': 'booking_date'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_booking" model="ir.actions.act_window">
        <field name="name">Booking Form</field>
        <field name="res_model">mst.sale.booking</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="sale_booking_search"/>
        <field name="context">{'search_default_my': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book greige for a customer</p>
            <p>A booking holds free stock after approval. Release it if the customer does not buy.</p>
        </field>
    </record>

    <record id="sale_booking_line_tree" model="ir.ui.view">
        <field name="name">mst.sale.booking.line.tree</field>
        <field name="model">mst.sale.booking.line</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-muted="state in ('closed', 'reject', 'cancel')">
                <field name="booking_id"/>
                <field name="booking_date"/>
                <field name="expiry_date"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="product_id"/>
                <field name="product_uom_qty" sum="Total"/>
                <field name="used_qty" sum="Total"/>
                <field name="released_qty" sum="Total"/>
                <field name="remaining_qty" sum="Total"/>
                <field name="product_uom" groups="uom.group_uom"/>
                <field name="state" widget="badge" decoration-success="state == 'booked'"
                       decoration-warning="state == 'to_approve'"/>
                <field name="note" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="sale_booking_line_search" model="ir.ui.view">
        <field name="name">mst.sale.booking.line.search</field>
        <field name="model">mst.sale.booking.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="booking_id"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="booked" string="Booked" domain="[('state', '=', 'booked')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_booking" string="Booking" context="{'group_by': 'booking_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_booking_line" model="ir.actions.act_window">
        <field name="name">Booking Form Line</field>
        <field name="res_model">mst.sale.booking.line</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="sale_booking_line_search"/>
    </record>

    <menuitem id="menu_sale_booking"
              name="Booking Form"
              parent="sale.sale_order_menu"
              action="action_sale_booking"
              sequence="50"/>
    <menuitem id="menu_sale_booking_line"
              name="Booking Form Line"
              parent="sale.sale_order_menu"
              action="action_sale_booking_line"
              sequence="51"/>
</odoo>
