<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_reservation_tree" model="ir.ui.view">
        <field name="name">mst.stock.reservation.tree</field>
        <field name="model">mst.stock.reservation</field>
        <field name="arch" type="xml">
            <tree create="0" decoration-muted="booking_status != 'booked'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_uom_qty" string="Reserved Qty" sum="Total"/>
                <field name="product_uom" groups="uom.group_uom"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="location_id"/>
                <field name="location_dest_id" optional="show"/>
                <field name="date_validity"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="sale_order_id"/>
                <field name="sale_order_line_id" optional="show"/>
                <field name="booking_status" widget="badge" decoration-success="booking_status == 'booked'"/>
            </tree>
        </field>
    </record>

    <record id="stock_reservation_form" model="ir.ui.view">
        <field name="name">mst.stock.reservation.form</field>
        <field name="model">mst.stock.reservation</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="open_release_wizard" string="Release" type="object" class="btn-primary"
                            invisible="booking_status != 'booked'"/>
                    <button name="open_move" string="View Reservation Move" type="object" invisible="not move_id"
                            groups="stock.group_stock_user"/>
                    <field name="booking_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_id" readonly="1"/>
                            <label for="product_uom_qty"/>
                            <div class="o_row">
                                <field name="product_uom_qty" readonly="1"/>
                                <field name="product_uom" readonly="1" groups="uom.group_uom"/>
                            </div>
                            <field name="location_id" readonly="1"/>
                            <field name="location_dest_id"/>
                            <field name="move_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="sale_order_id"/>
                            <field name="sale_order_line_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="date_validity" readonly="booking_status != 'booked'"/>
                        </group>
                    </group>
                    <group string="Booking Details">
                        <group>
                            <field name="free_qty"/>
                        </group>
                        <group>
                            <field name="used_qty"/>
                            <field name="released_qty"/>
                            <field name="remaining_qty"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_reservation_search" model="ir.ui.view">
        <field name="name">mst.stock.reservation.search</field>
        <field name="model">mst.stock.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="booked" string="Booked" domain="[('booking_status', '=', 'booked')]"/>
                <filter name="released" string="Released" domain="[('booking_status', '=', 'released')]"/>
                <filter name="done" string="Done" domain="[('booking_status', '=', 'done')]"/>
                <separator/>
                <filter name="expired" string="Expired"
                        domain="[('booking_status', '=', 'booked'), ('date_validity', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="groupby_status" string="Status" context="{'group_by': 'booking_status'}"/>
                    <filter name="groupby_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_location" string="Source Location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_stock_reservation" model="ir.actions.act_window">
        <field name="name">Stock Reservations</field>
        <field name="res_model">mst.stock.reservation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="stock_reservation_search"/>
        <field name="context">{'search_default_booked': 1, 'search_default_groupby_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No stock reservations</p>
            <p>Use "Book Stock" on a quotation to hold stock for the customer.</p>
        </field>
    </record>

    <menuitem id="menu_stock_reservation"
              name="Stock Reservations"
              parent="stock.menu_stock_warehouse_mgmt"
              action="action_stock_reservation"
              sequence="30"/>
</odoo>
