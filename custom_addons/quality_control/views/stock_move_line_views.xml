<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Detailed Operations: Assignee, Receiving Status, QC Request Status -->
    <record id="view_stock_move_line_detailed_operation_tree_inherit_qc" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit.qc</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="assignee_id" optional="show" widget="many2one_avatar_user"
                       readonly="state in ('done', 'cancel')" options="{'no_create': True}"/>
                <field name="receiving_status" optional="show"
                       readonly="state in ('done', 'cancel')"/>
                <field name="qc_request_status" optional="show" widget="badge"
                       decoration-info="qc_request_status == 'requested'"/>
            </xpath>
        </field>
    </record>

    <!-- Filter & Group By Receiving Status -->
    <record id="stock_move_line_view_search_inherit_qc" model="ir.ui.view">
        <field name="name">stock.move.line.search.inherit.qc</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inventory']" position="after">
                <separator/>
                <filter name="rs_to_store" string="To Store" domain="[('receiving_status', '=', 'to_store')]"/>
                <filter name="rs_qc_request" string="QC Request" domain="[('receiving_status', '=', 'qc_request')]"/>
                <filter name="rs_ready_for_qc" string="Ready for QC" domain="[('receiving_status', '=', 'ready_for_qc')]"/>
                <filter name="rs_done" string="Receiving Done" domain="[('receiving_status', '=', 'done')]"/>
                <filter name="qc_requested" string="QC Requested" domain="[('qc_request_status', '=', 'requested')]"/>
            </xpath>
            <xpath expr="//group[@name='groupby']" position="inside">
                <filter name="by_receiving_status" string="Receiving Status" context="{'group_by': 'receiving_status'}"/>
                <filter name="by_assignee" string="Assignee" context="{'group_by': 'assignee_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Action > Request QC (Detailed Operations) -->
    <record id="action_server_move_line_request_qc" model="ir.actions.server">
        <field name="name">Request QC</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="binding_model_id" ref="stock.model_stock_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('quality_control.group_qc_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_request_qc()</field>
    </record>
</odoo>
