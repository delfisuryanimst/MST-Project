<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qc_alert_stage_view_tree" model="ir.ui.view">
        <field name="name">qc.alert.stage.tree</field>
        <field name="model">qc.alert.stage</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="approver_ids" widget="many2many_tags"/>
                <field name="fold"/>
                <field name="done"/>
            </tree>
        </field>
    </record>

    <record id="qc_alert_stage_action" model="ir.actions.act_window">
        <field name="name">QC Alert Stages</field>
        <field name="res_model">qc.alert.stage</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
