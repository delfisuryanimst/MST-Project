<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qc_check_view_tree" model="ir.ui.view">
        <field name="name">qc.check.tree</field>
        <field name="model">qc.check</field>
        <field name="arch" type="xml">
            <tree default_order="id desc"
                  decoration-success="quality_state == 'pass'" decoration-danger="quality_state == 'fail'">
                <field name="name" string="Name"/>
                <field name="picking_id" string="Stock Picking"/>
                <field name="lot_name" string="Lot Number"/>
                <field name="qty_to_test" string="Qty to Test" sum="Total"/>
                <field name="product_id"/>
                <field name="picking_type_id" string="Operation Type"/>
                <field name="control_date" string="Date"/>
                <field name="point_id" string="QC Point"/>
                <field name="quality_state" string="Stage" widget="badge"
                       decoration-success="quality_state == 'pass'"
                       decoration-danger="quality_state == 'fail'"
                       decoration-info="quality_state == 'todo'"/>
                <field name="team_id"/>
                <field name="user_id" string="QC User"/>
                <field name="result" string="Status" widget="badge" invisible="quality_state == 'todo'"
                       decoration-success="result == 'pass'" decoration-danger="result == 'fail'"/>
                <field name="alert_count" string="QC Alerts"/>
                <field name="test_type" string="Type"/>
                <field name="qty_to_scrap" string="BS" sum="Total"/>

                <!-- Quantity columns (FDD) -->
                <field name="yard_counter_qty" optional="hide" sum="Total"/>
                <field name="difference_qty" optional="hide" sum="Total"/>
                <field name="pass_qty" optional="hide" sum="Total"/>
                <field name="fail_qty" optional="hide" sum="Total"/>
                <field name="qty_to_downgrade" string="Downgrade Qty" optional="hide" sum="Total"/>
                <field name="qty_to_sample" string="Sample Qty" optional="hide" sum="Total"/>
                <field name="nilai_grading" optional="hide"/>
                <field name="description" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="lot_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="qc_check_view_form" model="ir.ui.view">
        <field name="name">qc.check.form</field>
        <field name="model">qc.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" string="Validate" type="object" class="btn-primary"
                            invisible="quality_state != 'todo'"/>
                    <button name="action_create_alert" string="Quality Alerts" type="object" class="btn-primary"
                            invisible="quality_state != 'fail' or alert_count or not picking_id"/>
                    <button name="action_print" string="Print" type="object"/>
                    <button name="action_reset" string="Reset to Draft" type="object"
                            invisible="quality_state == 'todo'" groups="quality_control.group_qc_manager"/>
                    <field name="quality_state" widget="statusbar" statusbar_visible="todo,pass"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_alerts" type="object" class="oe_stat_button"
                                icon="fa-exclamation-triangle" invisible="alert_count == 0">
                            <field name="alert_count" widget="statinfo" string="Quality Alerts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <h2><field name="picking_id" readonly="1"/></h2>
                    <group>
                        <group name="check">
                            <field name="lot_id" invisible="1"/>
                            <field name="move_line_id" invisible="1"/>
                            <field name="product_domain_ids" invisible="1"/>
                            <field name="point_domain_ids" invisible="1"/>

                            <!-- From the detailed operation: only QC Administrator may edit (FDD) -->
                            <field name="product_id" groups="quality_control.group_qc_manager"
                                   readonly="quality_state != 'todo'"
                                   domain="[('id', 'in', product_domain_ids)] if picking_id else []"/>
                            <field name="product_id" groups="!quality_control.group_qc_manager"
                                   readonly="quality_state != 'todo' or move_line_id"
                                   domain="[('id', 'in', product_domain_ids)] if picking_id else []"/>
                            <field name="lot_name" groups="quality_control.group_qc_manager"
                                   readonly="quality_state != 'todo'"/>
                            <field name="lot_name" groups="!quality_control.group_qc_manager"
                                   readonly="quality_state != 'todo' or move_line_id"/>
                            <label for="qty_to_test"/>
                            <div class="o_row">
                                <field name="qty_to_test" groups="quality_control.group_qc_manager"
                                       readonly="quality_state != 'todo'"/>
                                <field name="qty_to_test" groups="!quality_control.group_qc_manager"
                                       readonly="quality_state != 'todo' or move_line_id"/>
                                <field name="product_uom_id" options="{'no_open': True}"/>
                            </div>
                            <label for="yard_asal" invisible="test_type != 'pass_fail'"/>
                            <div class="o_row" invisible="test_type != 'pass_fail'">
                                <field name="yard_asal" readonly="quality_state != 'todo'"/>
                                <field name="product_uom_id" options="{'no_open': True}"/>
                            </div>
                            <field name="point_id" string="QC Point" readonly="quality_state != 'todo'"
                                   domain="[('id', 'in', point_domain_ids)] if picking_id else []"/>
                            <field name="test_type" readonly="quality_state != 'todo'"/>

                            <!-- Pass / Fail -->
                            <field name="yard_counter_qty" invisible="test_type != 'pass_fail'"
                                   readonly="quality_state != 'todo'"/>
                            <field name="difference_qty" invisible="test_type != 'pass_fail'"/>
                            <label for="pass_qty" invisible="test_type != 'pass_fail'"/>
                            <div class="o_row" invisible="test_type != 'pass_fail'">
                                <field name="pass_qty" readonly="quality_state != 'todo'"/>
                                <field name="product_uom_id" options="{'no_open': True}"/>
                            </div>
                            <label for="fail_qty" invisible="test_type != 'pass_fail'"/>
                            <div class="o_row" invisible="test_type != 'pass_fail'">
                                <field name="fail_qty" readonly="quality_state != 'todo'"/>
                                <field name="product_uom_id" options="{'no_open': True}"/>
                            </div>
                            <label for="qty_to_downgrade" invisible="test_type != 'pass_fail'"/>
                            <div class="o_row" invisible="test_type != 'pass_fail'">
                                <field name="qty_to_downgrade" readonly="quality_state != 'todo'"/>
                                <field name="product_uom_id" options="{'no_open': True}"/>
                            </div>
                            <label for="qty_to_scrap" invisible="test_type != 'pass_fail'"/>
                            <div class="o_row" invisible="test_type != 'pass_fail'">
                                <field name="qty_to_scrap" readonly="quality_state != 'todo'"/>
                                <field name="product_uom_id" options="{'no_open': True}"/>
                            </div>
                            <field name="qty_to_sample" invisible="test_type != 'pass_fail'" readonly="quality_state != 'todo'"/>
                            <field name="result" invisible="test_type != 'pass_fail'" readonly="quality_state != 'todo'"/>
                            <field name="quality_state" string="Status" readonly="1"/>
                        </group>
                        <group name="info">
                            <field name="picking_id" string="Stock Picking" readonly="quality_state != 'todo'"/>
                            <field name="team_id"/>
                            <field name="user_id" string="QC User" readonly="quality_state != 'todo'"/>
                            <field name="control_date" string="Date"/>
                            <field name="partner_id"/>
                            <field name="company_id" readonly="1"/>
                            <field name="lebar_inch" readonly="quality_state != 'todo'"/>
                            <field name="akumulasi_poin"/>
                            <field name="nilai_grading" readonly="quality_state != 'todo'"/>
                            <field name="nilai_grading_after" readonly="quality_state != 'todo'"/>
                            <field name="description" readonly="quality_state != 'todo'"/>
                        </group>
                    </group>

                    <!-- Measurement -->
                    <group string="Measurement" invisible="test_type != 'measure'">
                        <label for="measure"/>
                        <div class="o_row">
                            <field name="measure" readonly="quality_state != 'todo'"/>
                            <field name="norm_unit"/>
                        </div>
                        <label for="tolerance_min" string="Tolerance"/>
                        <div class="o_row">
                            <field name="tolerance_min"/>
                            <span>to</span>
                            <field name="tolerance_max"/>
                        </div>
                    </group>

                    <!-- Take a picture -->
                    <group string="Picture" invisible="test_type != 'picture'">
                        <field name="picture" widget="image" readonly="quality_state != 'todo'"/>
                    </group>

                    <!-- Text -->
                    <group string="Text Result" invisible="test_type != 'text'">
                        <field name="text_result" readonly="quality_state != 'todo'"/>
                    </group>

                    <!-- Defect details (4 Point System) -->
                    <field name="detail_ids" readonly="quality_state != 'todo'">
                        <tree editable="bottom">
                            <field name="posisi_cacat"/>
                            <field name="yard_ke"/>
                            <field name="no_cacat"/>
                            <field name="nilai_poin" sum="Total Poin"/>
                            <field name="remarks"/>
                        </tree>
                    </field>

                    <notebook>
                        <page string="Message" name="message">
                            <field name="note"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Instructions" name="instructions" invisible="not point_id">
                            <field name="point_note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="qc_check_view_search" model="ir.ui.view">
        <field name="name">qc.check.search</field>
        <field name="model">qc.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="team_id"/>
                <field name="lot_name"/>
                <field name="partner_id"/>
                <filter name="todo" string="To Do" domain="[('quality_state', '=', 'todo')]"/>
                <filter name="passed" string="Passed" domain="[('quality_state', '=', 'pass')]"/>
                <filter name="failed" string="Failed" domain="[('quality_state', '=', 'fail')]"/>
                <separator/>
                <filter name="my" string="My Checks" domain="[('user_id', '=', uid)]"/>
                <filter name="picking_filter" string="Inventory" domain="[('picking_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_date" string="Control Date" date="control_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_inventory" string="Inventory" context="{'group_by': 'picking_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'quality_state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'test_type'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_picking_type" string="Operation Type" context="{'group_by': 'picking_type_id'}"/>
                    <filter name="group_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="qc_check_view_pivot" model="ir.ui.view">
        <field name="name">qc.check.pivot</field>
        <field name="model">qc.check</field>
        <field name="arch" type="xml">
            <pivot string="Quality Checks">
                <field name="team_id" type="row"/>
                <field name="quality_state" type="col"/>
                <field name="fail_qty" type="measure"/>
                <field name="pass_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="qc_check_view_graph" model="ir.ui.view">
        <field name="name">qc.check.graph</field>
        <field name="model">qc.check</field>
        <field name="arch" type="xml">
            <graph string="Quality Checks" type="bar">
                <field name="team_id"/>
                <field name="quality_state"/>
            </graph>
        </field>
    </record>

    <record id="qc_check_action" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">qc.check</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create New Quality Checks</p>
        </field>
    </record>

    <record id="qc_check_inventory_action" model="ir.actions.act_window">
        <field name="name">Inventory Quality Checks</field>
        <field name="res_model">qc.check</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="domain">[('picking_id', '!=', False)]</field>
        <field name="context">{'search_default_group_inventory': 1}</field>
    </record>

    <!-- Reporting > Quality Check -->
    <record id="qc_check_view_pivot_report" model="ir.ui.view">
        <field name="name">qc.check.pivot.report</field>
        <field name="model">qc.check</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <pivot string="Quality Check" sample="1"/>
        </field>
    </record>

    <!-- No Group By filters: the pivot "+" lists every field -->
    <record id="qc_check_view_search_report" model="ir.ui.view">
        <field name="name">qc.check.search.report</field>
        <field name="model">qc.check</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="lot_name"/>
                <field name="team_id"/>
                <field name="partner_id"/>
                <filter name="todo" string="To Do" domain="[('quality_state', '=', 'todo')]"/>
                <filter name="passed" string="Passed" domain="[('quality_state', '=', 'pass')]"/>
                <filter name="failed" string="Failed" domain="[('quality_state', '=', 'fail')]"/>
                <separator/>
                <filter name="picking_filter" string="Inventory" domain="[('picking_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_date" string="Control Date" date="control_date"/>
            </search>
        </field>
    </record>

    <record id="qc_check_report_action" model="ir.actions.act_window">
        <field name="name">Quality Check</field>
        <field name="res_model">qc.check</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="qc_check_view_pivot_report"/>
        <field name="search_view_id" ref="qc_check_view_search_report"/>
        <field name="context">{'search_default_picking_filter': 1}</field>
    </record>
</odoo>
