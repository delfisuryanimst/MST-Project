<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_qc" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.qc</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="has_on_demand_qc" invisible="1"/>
                <button name="action_request_qc" type="object" string="Request QC"
                        invisible="not has_on_demand_qc"
                        groups="quality_control.group_qc_user"/>
                <field name="has_failed_qc" invisible="1"/>
                <button name="open_quality_alert" type="object" string="Quality Alerts"
                        class="btn-primary" invisible="not has_failed_qc"
                        groups="quality_control.group_qc_user"/>
                <button name="action_execute_alerts" type="object" string="Execute Alerts"
                        invisible="qc_alert_count == 0"
                        groups="quality_control.group_qc_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="qc_todo_count" invisible="1"/>
                <button name="action_view_qc_checks" type="object" class="oe_stat_button"
                        icon="fa-check-square-o" invisible="qc_check_count == 0"
                        groups="quality_control.group_qc_user">
                    <field name="qc_check_count" widget="statinfo" string="Quality Checks"/>
                </button>
                <button name="action_view_qc_alerts" type="object" class="oe_stat_button"
                        icon="fa-bell" invisible="qc_alert_count == 0"
                        groups="quality_control.group_qc_user">
                    <field name="qc_alert_count" widget="statinfo" string="Quality Alerts"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='picked']" position="before">
                <field name="qty_a" optional="show"/>
                <field name="qty_a_star" optional="show"/>
                <field name="qty_b" optional="show"/>
                <field name="qty_ao_a2" optional="show"/>
                <field name="qty_a_grey_c_a1" optional="show"/>
                <field name="qty_bs" optional="show"/>
                <field name="k3l" optional="show"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Quality Checks" name="qc_checks" invisible="qc_check_count == 0"
                      groups="quality_control.group_qc_user">
                    <field name="qc_check_ids" nolabel="1" readonly="1">
                        <tree create="0" delete="0" decoration-danger="quality_state == 'fail'"
                              decoration-success="quality_state == 'pass'">
                            <field name="quality_state" column_invisible="1"/>
                            <field name="control_date" string="Date"/>
                            <field name="product_id"/>
                            <field name="lot_name" string="Lot / SN"/>
                            <field name="point_id" string="QC Point"/>
                            <field name="test_type" string="Type"/>
                            <field name="result" string="Status" widget="badge" invisible="quality_state == 'todo'"
                                   decoration-success="result == 'pass'" decoration-danger="result == 'fail'"/>
                            <field name="qty_to_test" string="Quantity to Test" sum="Total"/>
                            <field name="fail_qty" sum="Total"/>
                            <field name="user_id" string="QC User"/>
                        </tree>
                    </field>
                </page>
                <page string="Quality Alerts" name="qc_alerts" invisible="qc_alert_count == 0"
                      groups="quality_control.group_qc_user">
                    <field name="qc_alert_ids" nolabel="1" readonly="1">
                        <tree create="0" delete="0">
                            <field name="name"/>
                            <field name="title"/>
                            <field name="product_id"/>
                            <field name="lot_id" string="Lot / SN"/>
                            <field name="scrap_proposed_qty" sum="Total"/>
                            <field name="downgrade_proposed_qty" sum="Total"/>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="stage_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//sheet" position="before">
                <field name="qc_status" invisible="1"/>
                <div class="alert alert-info mb-0 text-center" role="alert" invisible="qc_status != 'pending'">
                    Product(s) Quality Control Still Pending
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_picking_search_inherit_qc" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit.qc</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='available']" position="after">
                <separator/>
                <filter name="qc_pending" string="Pending QC" domain="[('qc_status', '=', 'pending')]"/>
                <filter name="qc_failed" string="Failed QC" domain="[('qc_status', '=', 'failed')]"/>
                <filter name="qc_partial" string="Partially Passed QC" domain="[('qc_status', '=', 'partial')]"/>
                <filter name="qc_passed" string="Passed QC" domain="[('qc_status', '=', 'passed')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_qc_picking_all" model="ir.actions.act_window">
        <field name="name">QC Transfers</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('has_qc', '=', True)]</field>
        <field name="context">{'contact_display': 'partner_address', 'create': False}</field>
    </record>
    <record id="action_qc_picking_pending" model="ir.actions.act_window">
        <field name="name">Pending QC</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('has_qc', '=', True), ('qc_status', '=', 'pending')]</field>
        <field name="context">{'create': False, 'search_default_picking_type': 1}</field>
    </record>
    <record id="action_qc_picking_failed" model="ir.actions.act_window">
        <field name="name">Failed QC</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('has_qc', '=', True), ('qc_status', '=', 'failed')]</field>
        <field name="context">{'create': False, 'search_default_picking_type': 1}</field>
    </record>
    <record id="action_qc_picking_partial" model="ir.actions.act_window">
        <field name="name">Partially Passed QC</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('has_qc', '=', True), ('qc_status', '=', 'partial')]</field>
        <field name="context">{'create': False, 'search_default_picking_type': 1}</field>
    </record>
    <record id="action_qc_picking_passed" model="ir.actions.act_window">
        <field name="name">Passed QC</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('has_qc', '=', True), ('qc_status', '=', 'passed')]</field>
        <field name="context">{'create': False, 'search_default_picking_type': 1}</field>
    </record>

    <record id="vpicktree_inherit_qc" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit.qc</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="qc_status" optional="show" widget="badge"
                       decoration-info="qc_status == 'pending'"
                       decoration-danger="qc_status == 'failed'"
                       decoration-warning="qc_status == 'partial'"
                       decoration-success="qc_status == 'passed'"/>
            </field>
        </field>
    </record>
</odoo>
