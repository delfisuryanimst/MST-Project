<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_qc_check" model="ir.sequence">
        <field name="name">Quality Check</field>
        <field name="code">qc.check</field>
        <field name="prefix">QC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_qc_alert" model="ir.sequence">
        <field name="name">Quality Alert</field>
        <field name="code">qc.alert</field>
        <field name="prefix">QA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
