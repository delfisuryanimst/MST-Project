<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qc_alert_execute_wizard_view_form" model="ir.ui.view">
        <field name="name">qc.alert.execute.wizard.form</field>
        <field name="model">qc.alert.execute.wizard</field>
        <field name="arch" type="xml">
            <form string="Execute Alerts">
                <group>
                    <group>
                        <field name="team_id" options="{'no_create': True}"/>
                        <field name="user_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert" invisible="not note">
                    <field name="note" nolabel="1"/>
                </div>
                <field name="line_ids" nolabel="1">
                    <tree editable="bottom" create="0" delete="0" decoration-muted="has_scrap or has_conversion">
                        <field name="has_scrap" column_invisible="1"/>
                        <field name="has_conversion" column_invisible="1"/>
                        <field name="alert_id" force_save="1"/>
                        <field name="product_id"/>
                        <field name="lot_id"/>
                        <field name="scrap_proposed_qty" optional="hide"/>
                        <field name="scrap_qty" readonly="has_scrap"/>
                        <field name="downgrade_proposed_qty" optional="hide"/>
                        <field name="downgrade_qty" readonly="has_conversion"/>
                        <field name="result_product_id" options="{'no_create': True}"
                               readonly="has_conversion or downgrade_qty &lt;= 0" width="220px"/>
                        <field name="note" width="220px"/>
                    </tree>
                </field>
                <field name="alert_ids" invisible="1"/>
                <separator string="Split Result (optional)"/>
                <div class="text-muted mb-2">
                    For an alert whose Downgrade Qty goes to several results: one row per result. A row can
                    be another product, or the alert's own product to cut the roll into pieces. The rows of
                    one alert must add up to its Downgrade Qty, and its Result Product above is then not used.
                    Leave Lot empty for an automatic lot: for the alert's own product the biggest piece keeps
                    the lot and the other pieces get lot-2, lot-3...
                </div>
                <field name="split_ids" nolabel="1">
                    <tree editable="bottom">
                        <field name="alert_id" options="{'no_create': True, 'no_open': True}"
                               domain="[('id', 'in', parent.alert_ids)]"/>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="qty" sum="Total"/>
                        <field name="lot_name" placeholder="Automatic"/>
                    </tree>
                </field>
                <div class="text-muted">
                    Creates a draft Scrap and/or a draft Simplified MO per alert. Stock moves only when the
                    drafts are validated.
                </div>
                <footer>
                    <button name="action_create_drafts" string="Create Drafts" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="qc_alert_execute_wizard_action" model="ir.actions.act_window">
        <field name="name">Execute Alerts</field>
        <field name="res_model">qc.alert.execute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'dialog_size': 'extra-large'}</field>
        <field name="binding_model_id" ref="model_qc_alert"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('quality_control.group_qc_user'))]"/>
    </record>
</odoo>
