<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reporting > Quality Check Report -->
    <record id="qc_check_report_wizard_view_form" model="ir.ui.view">
        <field name="name">qc.check.report.wizard.form</field>
        <field name="model">qc.check.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Quality Check Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="group_by"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                        <field name="state" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="print_report" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="qc_check_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Quality Check Report</field>
        <field name="res_model">qc.check.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Reporting > Quality Alert Report -->
    <record id="qc_alert_report_wizard_view_form" model="ir.ui.view">
        <field name="name">qc.alert.report.wizard.form</field>
        <field name="model">qc.alert.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Quality Alert Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                        <field name="stage_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="print_report" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="qc_alert_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Quality Alert Report</field>
        <field name="res_model">qc.alert.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
