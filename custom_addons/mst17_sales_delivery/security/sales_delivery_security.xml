<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_delivery_all" model="res.groups">
        <field name="name">Data Pengiriman: semua tim</field>
        <field name="comment">Melihat Data Pengiriman semua tim (PPIC). Sales Administrator otomatis punya hak ini.</field>
    </record>
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_delivery_all'))]"/>
    </record>

    <record id="rule_sales_delivery_report_own" model="ir.rule">
        <field name="name">Data Pengiriman: hanya form milik sendiri</field>
        <field name="model_id" ref="model_sales_delivery_report"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
