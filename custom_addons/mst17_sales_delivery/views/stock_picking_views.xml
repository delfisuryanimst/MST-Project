<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_sales_delivery" model="ir.ui.view">
        <field name="name">stock.picking.form.sales.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="admin_return" groups="sales_team.group_sale_manager,mst17_sales_delivery.group_delivery_all"/>
                <field name="replacement_of_id" options="{'no_create': True}"
                       invisible="picking_type_code != 'outgoing'"
                       groups="sales_team.group_sale_manager,mst17_sales_delivery.group_delivery_all"/>
                <field name="delivery_excluded" invisible="not delivery_excluded"
                       groups="sales_team.group_sale_manager,mst17_sales_delivery.group_delivery_all"/>
            </field>
        </field>
    </record>
</odoo>
